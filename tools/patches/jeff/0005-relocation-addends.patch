+/// The displacement the PAIR record after a REFHI carries: the low 16 bits of the addend (its high half, adjusted
+/// for their sign, is in the instruction). The linker ignores the PAIR after a REFLO; the compiler writes zero there.
+fn pair_displacement(reloc: &ObjReloc) -> Option<u32> {
+    match reloc.kind {
+        ObjRelocKind::PpcAddr16Ha => Some(reloc.addend as u32 & 0xFFFF),
+        _ => None,
+    }
+}
